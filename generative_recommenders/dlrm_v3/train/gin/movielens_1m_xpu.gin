# XPU-optimized configuration for DLRM-V3 on MovieLens-1M
# Reduced memory footprint for Intel XPU devices
# Based on movielens_1m.gin with adjusted parameters
#
# Embedding table dim / hash size are controlled by the HSTU_EMBEDDING_DIM and
# HASH_SIZE environment variables (set to 128 and 1_000_000 respectively for
# XPU in run_dlrm_v3_xpu.sh) since they're shared between get_hstu_configs()
# and get_embedding_table_config() in configs.py. All other HSTU dims below
# are plain gin bindings.

batch_size = 16  # Small batch for XPU memory constraints
dataset = "movielens-1m"

# model parameters
make_model.dataset = %dataset
get_hstu_configs.hstu_num_heads = 4
get_hstu_configs.hstu_attn_linear_dim = 64
get_hstu_configs.hstu_attn_qk_dim = 64
get_hstu_configs.hstu_attn_num_layers = 3
get_hstu_configs.hstu_preprocessor_hidden_dim = 128
get_hstu_configs.hstu_transducer_embedding_dim = 128

# dense model optimizer
dense_optimizer_factory_and_class.learning_rate = 0.001
dense_optimizer_factory_and_class.optimizer_name = "Adam"
dense_optimizer_factory_and_class.momentum = 0
dense_optimizer_factory_and_class.weight_decay = 0
dense_optimizer_factory_and_class.eps = 1e-8
dense_optimizer_factory_and_class.betas = (0.9, 0.98)

# sparse model optimizer
sparse_optimizer_factory_and_class.learning_rate = 0.001
sparse_optimizer_factory_and_class.optimizer_name = "RowWiseAdagrad"
sparse_optimizer_factory_and_class.momentum = 0
sparse_optimizer_factory_and_class.weight_decay = 0
sparse_optimizer_factory_and_class.eps = 1e-8
sparse_optimizer_factory_and_class.betas = (0.95, 0.999)

# dataloader configs
make_train_test_dataloaders.batch_size = %batch_size
make_train_test_dataloaders.dataset_type = %dataset
make_train_test_dataloaders.train_split_percentage = 0.75
make_train_test_dataloaders.new_path_prefix = "/workspace/src/generative-recommenders/datasets"
make_train_test_dataloaders.num_workers = 0  # XPU doesn't support multiprocessing workers
make_train_test_dataloaders.prefetch_factor = None  # Required when num_workers=0

# train-eval loop variables
train_eval_loop.num_epochs = 3  # Quick validation (bump later)
train_eval_loop.output_trace = False  # Manifold not available outside Meta
train_eval_loop.metric_log_frequency = 50  # Log every 50 batches to avoid spam
train_eval_loop.eval_frequency = 100  # Eval every 100 train batches (not every 1!)
train_eval_loop.num_eval_batches = 20  # Limit eval to 20 batches
train_eval_loop.checkpoint_frequency = 99999  # Skip checkpoints (Manifold not available)

# train-only loop variables (--mode train)
train_loop.num_epochs = 3  # Quick validation (bump later)
train_loop.output_trace = False  # Manifold not available outside Meta
train_loop.metric_log_frequency = 50  # Log every 50 batches to avoid spam
train_loop.checkpoint_frequency = 99999  # Skip checkpoints (Manifold not available)

# logger variables
MetricsLogger.tensorboard_log_path = "/tmp/tensorboard_log_path_xpu.log"
